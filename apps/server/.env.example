DATABASE_URL=postgres://user:password@localhost:5432/navbot
NODE_ENV=development
PORT=3000

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_BASE_URL=http://localhost:3000/api/auth

# Must be the exact same value as NAVBOT_API_TOKEN_SECRET in apps/api/.env
NAVBOT_API_TOKEN_SECRET=

# Optional — error tracking is a no-op until this is set.
SENTRY_DSN=

WEB_APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
