PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/navbot
DB_SSL_REJECT_UNAUTHORIZED=true

# Dashboard origin allowed to call the /api/sites dashboard routes (not the public widget/chat routes).
# In production this must be set to your deployed dashboard's origin, e.g. https://navbot-web.onrender.com
CORS_ORIGIN=http://localhost:5173

# Must be the exact same value as NAVBOT_API_TOKEN_SECRET in apps/server/.env — required in production.
NAVBOT_API_TOKEN_SECRET=
# Signs anonymous visitor daily-quota tokens — required in production.
NAVBOT_SESSION_SECRET=

# Optional — error tracking is a no-op until this is set.
SENTRY_DSN=

PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_HOST=
PINECONE_EMBEDDING_MODEL=
PINECONE_EMBEDDING_DIMENSION=
PINECONE_UPSERT_MODE=
PINECONE_EMBED_TEXT_FIELD=
PINECONE_RERANK_MODEL=

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_PLANNER_MODEL=
GEMINI_TTS_VOICE=Kore

SERPER_API_KEY=
JINA_API_KEY=

NAVBOT_BROWSER_CRAWL=auto
NAVBOT_CRAWL_CONCURRENCY=3
NAVBOT_CRAWL_DELAY_MS=150
NAVBOT_BROWSER_TIMEOUT_MS=60000
NAVBOT_BROWSER_SETTLE_MS=2000
NAVBOT_DEBUG_RAW=false
NAVBOT_DISABLE_CACHE=false

AUTO_SYNC_CRON=

# Eval scripts (apps/api/eval)
EVAL_SITE_ID=
EVAL_RPM=
EVAL_CONCURRENCY=
