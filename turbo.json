{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },

    "lint": {},

    "dev": {
      "cache": false
    },

    "web#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/chat-widget#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/chat-widget/dist/**"
      ]
    }
  }
}