{
  "name": "@repo/chat-widget",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/chat-widget.umd.cjs",
  "module": "./dist/chat-widget.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
